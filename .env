# ─────────────────────────────────────────────────────────────
# Agora — environment configuration
# Copy this file to `.env` and fill in YOUR values.
# Never commit `.env` (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────

# REQUIRED — free key from https://console.groq.com
GROQ_API_KEY=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

# Model. Groq retires models regularly — check https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-20b
# For gpt-oss models: low | medium | high (leave empty to disable)
GROQ_REASONING_EFFORT=low

# OPTIONAL — https://openweathermap.org/api (wttr.in is used when empty)
OPENWEATHER_API_KEY=beb47041f82106d8a19356795da59381

# Tuning
MAX_HISTORY=20
MAX_TOKENS=1500
TEMPERATURE=0.6
RATE_LIMIT_PER_MIN=20
